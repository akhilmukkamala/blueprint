# [mcp_servers] entries blueprint generated by blueprint v0 from .blueprint/config.toml [mcp.servers]; other keys are yours — edit the source, then run `blueprint sync`
# [sandbox_workspace_write] guidance generated by blueprint v0 from .blueprint/safety.toml — codex cannot enforce per-glob write denies (see .codex/sandbox-policy.md); `blueprint verify` tamper hashes are the backstop
model = "o3"

[mcp_servers]
[mcp_servers.blueprint]
args = ["mcp", "serve"]
command = "blueprint"
[mcp_servers.docs]
command = "docs-server"

[sandbox_workspace_write]
network_access = false

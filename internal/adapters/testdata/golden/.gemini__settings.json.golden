{
  "//blueprint": "context.fileName (AGENTS.md) and any [mcp.servers] entries here are generated by blueprint v0 via `blueprint sync`; other keys are yours — edit .blueprint/config.toml, not this file",
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ]
  },
  "mcpServers": {
    "blueprint": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "blueprint"
    },
    "weather": {
      "command": "weather-server"
    }
  },
  "theme": "dark"
}

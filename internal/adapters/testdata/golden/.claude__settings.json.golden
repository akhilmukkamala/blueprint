{
  "//blueprint": "permission deny rules below are generated by blueprint v0 from .blueprint/safety.toml [deny].write via `blueprint sync`; edit safety.toml, not this list",
  "permissions": {
    "deny": [
      "Write(.env*)",
      "Edit(.env*)",
      "Write(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Write(.github/workflows/**)",
      "Edit(.github/workflows/**)"
    ]
  }
}
